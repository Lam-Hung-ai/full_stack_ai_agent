# Database (compose.yaml at the repository root starts PostgreSQL 18 on 5433).
# SQLAlchemy URL, psycopg 3 driver.
DATABASE_URL=postgresql+psycopg://agent:agent@127.0.0.1:5433/agent_chat
# dbmate cannot read the SQLAlchemy form; it needs a libpq URL.
DBMATE_DATABASE_URL=postgres://agent:agent@127.0.0.1:5433/agent_chat?sslmode=disable

# Auth (QD-12). Generate a secret: python -c "import secrets;print(secrets.token_urlsafe(48))"
JWT_SECRET=
ACCESS_TOKEN_MINUTES=15
REFRESH_TOKEN_DAYS=30
# Self-service sign-up; off in production unless intended.
REGISTRATION_ENABLED=false
# false only on plain-http local development.
COOKIE_SECURE=true
AUTH_RATE_LIMIT=30

ALLOWED_ORIGINS=["http://localhost:3000"]
# Live view of running turns and stop signals (compose or local Redis).
REDIS_URL=redis://localhost:6379/0
# json on servers, text on a dev machine.
LOG_FORMAT=text
LOG_LEVEL=INFO

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4.5
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_REASONING_EFFORT=high
OPENROUTER_SITE_URL=
OPENROUTER_APP_NAME=agent-backend

# Tools that pause for the user's approval before running, e.g. ["get_current_time"].
TOOLS_REQUIRING_APPROVAL=[]

# Outgoing mail: invitations, email verification, password reset. Empty host
# drops letters with a warning. Dev: `docker compose up -d mailpit`, then
# SMTP_HOST=localhost, SMTP_PORT=1025, SMTP_STARTTLS=false; read at :8025.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=noreply@example.com
SMTP_STARTTLS=true
# Links in letters point here.
FRONTEND_URL=http://localhost:3000
